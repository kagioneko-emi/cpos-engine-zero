# Example only. Do not deploy without adapting paths, hostnames, and CA files.
# Nginx terminates HTTPS/mTLS and forwards sanitized headers to CPOS.

server {
    listen 443 ssl http2;
    server_name cpos.example.invalid;

    ssl_certificate     /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;

    # Client certificate verification.
    ssl_client_certificate /etc/nginx/tls/client-ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 2;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        # Remove any spoofed inbound header, then set trusted fingerprint.
        proxy_set_header X-SSL-Client-SHA256 "";
        proxy_set_header X-SSL-Client-SHA256 $ssl_client_fingerprint;

        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;

        proxy_pass http://127.0.0.1:8080;
    }
}
