# Non-secret CPOS hardened profile settings.
# Secret values must be provided as files from Vault/secret volume.

CPOS_SECURITY_PROFILE=hardened
CPOS_ENFORCE_HTTPS=true
CPOS_REQUIRE_FIX_APPROVAL=true

# API authentication / authorization
CPOS_REQUIRE_API_AUTH=true
CPOS_REQUIRE_HMAC_AUTH=true
CPOS_API_HMAC_KEY_REGISTRY_FILE=/run/secrets/cpos_hmac_keys.json
CPOS_API_NONCE_STORE_PATH=/var/lib/cpos/nonce_seen.jsonl
CPOS_HMAC_TIMESTAMP_WINDOW_SECONDS=300

# mTLS fingerprint gate; actual mTLS is terminated by trusted reverse proxy.
CPOS_REQUIRE_CLIENT_CERT=true
CPOS_CLIENT_CERT_FINGERPRINTS_FILE=/run/secrets/cpos_client_fingerprints.txt
CPOS_CLIENT_CERT_FINGERPRINT_HEADER=X-SSL-Client-SHA256
CPOS_CLIENT_CERT_POLICY_MODE=enforce

# Network policy
CPOS_TRUST_PROXY_HEADERS=true
CPOS_IP_ALLOWLIST=127.0.0.1/32,::1/128
CPOS_RATE_LIMIT_ENABLED=true
CPOS_RATE_LIMIT_REQUESTS=60
CPOS_MUTATION_RATE_LIMIT_REQUESTS=10
CPOS_RATE_LIMIT_WINDOW_SECONDS=60

# Sandbox
CPOS_SANDBOX_MODE=strict
CPOS_SANDBOX_MEMORY=256m
CPOS_SANDBOX_CPUS=0.5
CPOS_SANDBOX_PIDS_LIMIT=128

# Optional encrypted pointer storage key file.
CPOS_STORAGE_KEY_FILE=/run/secrets/cpos_storage.key

# Optional Redis/Valkey distributed rate-limit backend.
# Store the Redis URL in Vault and render it to this file at runtime.
# Do not put redis:// credentials directly in this env file.
# CPOS_RATE_LIMIT_BACKEND=redis
# CPOS_RATE_LIMIT_REDIS_URL_FILE=/run/secrets/cpos_redis_rate_limit_url
# CPOS_RATE_LIMIT_REDIS_KEY_PREFIX=cpos:rate_limit
